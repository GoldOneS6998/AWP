rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /usuarios/{uid}/listas/{listaId} {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['nombre','creadoEn'])
    && request.resource.data.nombre is string
    && request.resource.data.nombre.size() > 0
    && request.resource.data.nombre.size() <= 100
    && request.resource.data.creadoEn == request.time;
   allow update: if false;
   match /tareas/{tareaId} {
    allow read, delete: if request.auth != null && request.auth.uid == uid;
    allow create: if request.auth != null && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['descripcion','pendientes','creadoEn'])
     && request.resource.data.descripcion is string
     && request.resource.data.descripcion.size() > 0
     && request.resource.data.descripcion.size() <= 300
     && request.resource.data.pendientes is string
     && request.resource.data.pendientes.size() <= 1000
     && request.resource.data.creadoEn == request.time;
    allow update: if false;
   }
  }
 }
}